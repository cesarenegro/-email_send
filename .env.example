# Supabase KONTA (progetto condiviso con KONTA PRO e K-CRM)
# In locale: valori di `npx supabase status -o env` eseguito in E:\Projects\KONTA MASTER\KONTA K-CRM
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Account KONTA unico: dominio del cookie di sessione condiviso fra le app (solo produzione: .arkai.dev).
# Assente in locale e nelle preview *.vercel.app → cookie host-only.
NEXT_PUBLIC_KONTA_AUTH_COOKIE_DOMAIN=

# Cifratura dei segreti a riposo (AES-256-GCM, 32 byte base64 o hex): stessa chiave dell'ecosistema KONTA.
# Obbligatoria in produzione; in locale, se assente, viene derivata una chiave di sviluppo.
KCRM_SECRET_ENCRYPTION_KEY=

# Ponte K-CRM (tappa M3): origine dell'API di K-CRM (https in produzione)
KCRM_API_URL=

# Cron (Bearer token per /api/cron/*)
CRON_SECRET=

# App
NEXT_PUBLIC_APP_NAME=MAIL-K
NEXT_PUBLIC_APP_URL=https://mailk.arkai.dev

# Modulo opzionale Lead Research (fuori dalla tappa M1): attivo solo se true
LEAD_RESEARCH_ENABLED=false
OPENAI_API_KEY=
TAVILY_API_KEY=

# Solo per il collaudo dell'invio SMTP di prova (facoltativa)
MAILK_TEST_EMAIL_TO=
